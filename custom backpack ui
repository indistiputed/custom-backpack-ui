local function updateEditorLayout()
	local w = editor.AbsoluteSize.X

	if w <= 0 then
		return
	end

	local gap = math.clamp(math.floor(w * 0.018), 5, 12)
	local cw = math.floor((w - 6 - gap * 9) / 10)

	cw = math.clamp(cw, 20, 56)

	local ch = math.clamp(cw + 8, 44, 56)

	editorGrid.CellPadding = UDim2.fromOffset(gap, 0)
	editorGrid.CellSize = UDim2.fromOffset(cw, ch)
end

editor:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateEditorLayout)

local function toScreen(position)
	local inset = GuiService:GetGuiInset()
	return Vector2.new(position.X + inset.X, position.Y + inset.Y)
end

local function getTools()
	local tools = {}
	local seen = {}
	local backpack = plr:FindFirstChildOfClass("Backpack")
	local character = plr.Character

	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				seen[tool] = true

				if not toolOrder[tool] then
					orderCounter += 1
					toolOrder[tool] = orderCounter
				end
			end
		end
	end

	if character then
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				seen[tool] = true

				if not toolOrder[tool] then
					orderCounter += 1
					toolOrder[tool] = orderCounter
				end
			end
		end
	end

	for tool in pairs(toolOrder) do
		if not seen[tool] then
			toolOrder[tool] = nil
		end
	end

	for tool in pairs(seen) do
		table.insert(tools, tool)
	end

	table.sort(tools, function(a, b)
		return toolOrder[a] < toolOrder[b]
	end)

	return tools
end

local function isEquipped(tool)
	local character = plr.Character
	return character and tool.Parent == character
end

local function getHotbarSlot(tool)
	for i = 1, 10 do
		if hotbarTools[i] == tool then
			return i
		end
	end

	return nil
end

local function getEmptyHotbarSlot()
	for i = 1, 10 do
		if not hotbarTools[i] then
			return i
		end
	end

	return nil
end

local function setVisual(slotData, state)
	if not slotData or not slotData.stroke or not slotData.stroke.Parent then
		return
	end

	slotData.stroke.Enabled = true
	slotData.stroke.Color = state
		and Color3.fromRGB(255, 255, 255)
		or Color3.fromRGB(58, 58, 68)
	slotData.stroke.Thickness = state and 2.5 or 1.5
	slotData.stroke.Transparency = 0
end

local function setBackpackVisual(state)
	TweenService:Create(
		backpackStroke,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Color = state
				and Color3.fromRGB(255, 255, 255)
				or Color3.fromRGB(60, 60, 70),
			Thickness = state and 2.5 or 1.5
		}
	):Play()
end

local function spinBackpack(state)
	spinAngle += state and 360 or -360

	TweenService:Create(
		backpackIcon,
		TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Rotation = spinAngle}
	):Play()
end

updateVisuals = function()
	for tool, slotData in pairs(slots) do
		if tool:IsDescendantOf(plr) then
			setVisual(slotData, isEquipped(tool))
		end
	end

	for i, slotData in pairs(editorSlots) do
		if slotData.tool and i ~= hoverSlot then
			setVisual(slotData, isEquipped(slotData.tool))
		end
	end

	for tool, slotData in pairs(inventoryItems) do
		if tool:IsDescendantOf(plr) then
			setVisual(slotData, isEquipped(tool))
		end
	end
end

local function clickEffect(slotData)
	if not slotData or not slotData.scale or not slotData.scale.Parent then
		return
	end

	slotData.scale.Scale = 1

	TweenService:Create(
		slotData.scale,
		TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Scale = 0.92}
	):Play()

	task.delay(0.08, function()
		if slotData.scale.Parent then
			TweenService:Create(
				slotData.scale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Scale = 1}
			):Play()
		end
	end)
end

local function equipTool(tool)
	local character = plr.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not humanoid or not tool then
		return
	end

	if isEquipped(tool) then
		humanoid:UnequipTools()
	else
		humanoid:EquipTool(tool)
	end
end

local function connectTool(tool)
	if toolConnections[tool] then
		return
	end

	toolConnections[tool] = {
		tool.Equipped:Connect(function()
			setVisual(slots[tool], true)

			local slot = getHotbarSlot(tool)

			if slot and slot ~= hoverSlot then
				setVisual(editorSlots[slot], true)
			end

			setVisual(inventoryItems[tool], true)
		end),
		tool.Unequipped:Connect(function()
			setVisual(slots[tool], false)

			local slot = getHotbarSlot(tool)

			if slot and slot ~= hoverSlot then
				setVisual(editorSlots[slot], false)
			end

			setVisual(inventoryItems[tool], false)
		end)
	}
end

local function disconnectTool(tool)
	local connections = toolConnections[tool]

	if not connections then
		return
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end

	toolConnections[tool] = nil
end

local function clearButtons(parent)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function getEditorSlotAt(position)
	local ep = editor.AbsolutePosition
	local es = editor.AbsoluteSize

	if position.Y < ep.Y - 24
		or position.Y > ep.Y + es.Y + 24
		or position.X < ep.X - 14
		or position.X > ep.X + es.X + 14 then
		return nil
	end

	local best = nil
	local bestDist = math.huge

	for i = 1, 10 do
		local slotData = editorSlots[i]

		if slotData and slotData.button.Parent then
			local button = slotData.button
			local center = button.AbsolutePosition.X + button.AbsoluteSize.X / 2
			local dist = math.abs(position.X - center)

			if dist < bestDist then
				bestDist = dist
				best = i
			end
		end
	end

	return best
end

local function resetEditorSlot(slotData)
	if not slotData or not slotData.button.Parent then
		return
	end

	slotData.button.BackgroundColor3 = slotData.tool
		and Color3.fromRGB(20, 20, 24)
		or Color3.fromRGB(18, 18, 22)
	slotData.button.BackgroundTransparency = slotData.tool and 0 or 0.35

	setVisual(slotData, slotData.tool and isEquipped(slotData.tool))
end

local function setHover(slot)
	if slot == hoverSlot then
		return
	end

	local prev = hoverSlot and editorSlots[hoverSlot]

	hoverSlot = slot

	resetEditorSlot(prev)

	local cur = slot and editorSlots[slot]

	if cur and slot ~= dragSlot and cur.button.Parent then
		cur.button.BackgroundColor3 = Color3.fromRGB(48, 48, 58)
		cur.button.BackgroundTransparency = 0
		cur.stroke.Color = Color3.fromRGB(255, 255, 255)
		cur.stroke.Thickness = 3
		cur.stroke.Transparency = 0
	end
end

local function showDragGhost(tool, slot, position)
	dragGhostNumber.Text = slot and (slot == 10 and "0" or tostring(slot)) or ""
	dragGhostIcon.Image = tool.TextureId or ""
	dragGhostFallback.Text = string.upper(string.sub(tool.Name, 1, 1))
	dragGhostFallback.Visible = tool.TextureId == ""
	dragGhostName.Text = tool.Name
	dragGhost.Position = UDim2.fromOffset(position.X, position.Y)
	dragGhost.Visible = true
end

local function hideDragGhost()
	dragGhost.Visible = false
end

local function beginDragging(position)
	if dragging or not dragTool then
		return
	end

	dragging = true
	showDragGhost(dragTool, dragSlot, position)
	setHover(getEditorSlotAt(position))
end

local function stopInteraction()
	setHover(nil)
	dragTool = nil
	dragSlot = nil
	dragInput = nil
	dragStart = nil
	dragging = false
	dragScale = nil
	hideDragGhost()
end

local function beginPress(tool, slot, input, scale)
	if not tool then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if dragTool and dragInput and dragInput.UserInputState == Enum.UserInputState.End then
		stopInteraction()
	end

	if dragTool then
		return
	end

	dragTool = tool
	dragSlot = slot
	dragInput = input
	dragStart = toScreen(input.Position)
	dragging = false
	dragScale = scale
end

local function finishPress(position, input)
	if not dragTool or input ~= dragInput then
		return
	end

	local tool = dragTool
	local sourceSlot = dragSlot
	local wasDragging = dragging
	local scale = dragScale
	local targetSlot = hoverSlot

	if wasDragging then
		stopInteraction()

		if targetSlot and targetSlot ~= sourceSlot and hotbarTools[sourceSlot] == tool then
			local targetTool = hotbarTools[targetSlot]

			hotbarTools[sourceSlot] = targetTool
			hotbarTools[targetSlot] = tool

			refreshHotbar()
			refreshEditor()
			updateVisuals()
		end

		return
	end

	stopInteraction()

	if scale then
		clickEffect({
			scale = scale
		})
	end

	equipTool(tool)
end

local function updateDragPosition(position)
	if not dragTool or not dragging then
		return
	end

	dragGhost.Position = UDim2.fromOffset(position.X, position.Y)
	setHover(getEditorSlotAt(position))
end


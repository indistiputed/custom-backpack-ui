local function hasSameTools(tools)
	local current = {}

	for _, tool in ipairs(tools) do
		current[tool] = true
	end

	for _, tool in ipairs(tools) do
		if not toolConnections[tool] then
			return false
		end
	end

	for tool in pairs(toolConnections) do
		if not current[tool] then
			return false
		end
	end

	return true
end

syncTools = function()
	local tools = getTools()
	local changed = not hasSameTools(tools)

	for _, tool in ipairs(tools) do
		connectTool(tool)
	end

	for tool in pairs(toolConnections) do
		local exists = false

		for _, current in ipairs(tools) do
			if current == tool then
				exists = true
				break
			end
		end

		if not exists then
			disconnectTool(tool)

			for slot = 1, 10 do
				if hotbarTools[slot] == tool then
					hotbarTools[slot] = nil
				end
			end

			toolOrder[tool] = nil
			changed = true
		end
	end

	for _, tool in ipairs(tools) do
		if not getHotbarSlot(tool) then
			local empty = getEmptyHotbarSlot()

			if empty then
				hotbarTools[empty] = tool
				changed = true
			end
		end
	end

	if changed then
		if dragging then
			stopInteraction()
		end

		refreshHotbar()
		refreshEditor()
		refreshInventory()
	end

	updateVisuals()
end

local function queueSync()
	if refreshQueued then
		return
	end

	refreshQueued = true

	task.defer(function()
		refreshQueued = false
		syncTools()
	end)
end

local function setInventory(state)
	if not state then
		stopInteraction()
	end

	inventoryOpen = state
	inventory.Visible = state
	bar.Visible = not state

	setBackpackVisual(state)
	spinBackpack(state)

	if state then
		updateEditorLayout()
		refreshInventory()
		refreshEditor()

		inventory.Position = UDim2.new(0.5, 0, 0.5, 8)

		TweenService:Create(
			inventory,
			TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(0.5, 0, 0.5, 0)
			}
		):Play()
	end
end

